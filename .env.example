# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Docker Compose ---
# Password for the PostgreSQL 'sentineltrace' user. Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ST_PG_PASSWORD=
ST_ENVIRONMENT=development
ST_MAX_UPLOAD_BYTES=52428800

# --- Running the backend directly (without Docker): put these in backend/.env ---
# ST_DATABASE_URL=postgresql+psycopg://sentineltrace:<password>@127.0.0.1:5432/sentineltrace
# ST_CORS_ORIGINS=          # leave empty when using the Vite dev proxy (same-origin)
