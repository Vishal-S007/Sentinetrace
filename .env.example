# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Docker Compose ---
# Password for the PostgreSQL 'sentineltrace' user. Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ST_PG_PASSWORD=
ST_ENVIRONMENT=development
ST_MAX_UPLOAD_BYTES=52428800
# true when served over HTTPS (always in production)
ST_COOKIE_SECURE=false

# Optional tuning (defaults shown)
# ST_SESSION_IDLE_MINUTES=60
# ST_SESSION_ABSOLUTE_HOURS=12
# ST_LOGIN_WINDOW_SECONDS=900
# ST_LOGIN_MAX_FAILURES_PER_USER=5
# ST_LOGIN_MAX_FAILURES_PER_IP=20
# ST_STORAGE_DIR=storage            # where uploaded files are kept (content-addressed)
# ST_MAX_LINE_BYTES=16384
# ST_MAX_LINES_PER_FILE=5000000
# ST_MAX_ERRORS_PER_JOB=10000
# ST_ALERT_GROUP_MINUTES=60        # alert grouping bucket
# ST_MAX_EVIDENCE_PER_ALERT=500
# ST_DETECTION_CHUNK_HOURS=24
# ST_RETENTION_AUTO_DAYS=          # e.g. 90: the worker purges older data once a day (off by default)
# ST_RETENTION_MIN_DAYS=7          # purges with a shorter period are refused
# ST_EXPORT_RATE_PER_MINUTE=10     # exports + incident reports per user per minute

# --- Running the backend directly (without Docker): put these in backend/.env ---
# ST_DATABASE_URL=postgresql+psycopg://sentineltrace:<password>@127.0.0.1:5432/sentineltrace
# ST_CORS_ORIGINS=          # leave empty when using the Vite dev proxy (same-origin)
